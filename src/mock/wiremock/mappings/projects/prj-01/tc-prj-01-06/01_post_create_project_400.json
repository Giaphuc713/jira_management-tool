{
  "name": "TC-PRJ-01-06 POST reject key below minimum length",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/projects",
    "headers": { "X-User-Id": { "equalTo": "6afd1c2c7c593acdcf1a8416" } },
    "bodyPatterns": [
      {
        "equalToJson": { "key": "Q", "name": "Short Key" },
        "ignoreExtraElements": true
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "error": {
        "code": "VALIDATION_ERROR",
        "message": "Invalid project data",
        "details": [
          {
            "field": "key",
            "message": "key must be 2 to 10 uppercase letters A-Z"
          }
        ]
      }
    }
  }
}
