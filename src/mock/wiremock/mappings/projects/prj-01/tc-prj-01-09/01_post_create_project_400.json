{
  "name": "TC-PRJ-01-09 POST reject key that contains a space",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/projects",
    "headers": { "X-User-Id": { "equalTo": "6afd1c2c7c593acdcf1a8416" } },
    "bodyPatterns": [
      {
        "equalToJson": { "key": "QA T", "name": "Space Key" },
        "ignoreExtraElements": true
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "error": {
        "code": "VALIDATION_ERROR",
        "message": "Invalid project data",
        "details": [
          { "field": "key", "message": "key must contain letters A-Z only" }
        ]
      }
    }
  }
}
