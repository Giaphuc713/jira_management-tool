{
  "name": "TC-USR-01-02 Missing X-User-Id is rejected",
  "request": {
    "method": "GET",
    "urlPath": "/api/users",
    "headers": {
      "X-User-Id": { "absent": true }
    }
  },
  "response": {
    "status": 401,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "error": {
        "code": "UNAUTHORIZED",
        "message": "X-User-Id header is required"
      }
    }
  }
}
